#!/usr/bin/env xeo
-- xeo script example (v4)
print "--- starting xeon engine ---"

-- 1. basic variables and math
set $base_val 10 + 5
set $total $base_val * 2
print "the calculated total is: " $total

-- 2. string manipulation
set $greeting "hello" + "_" + "world"
print "message: " $greeting
sleep 200
print "slept 200ms"
print "printing multiline strings:"
print "line1\nline2\nline3"
print "
line4
line5
line6
"
print "
line7
line8
line9
"

-- 3. user interaction
ask $user_name "what is your name? "
print "welcome to the engine, " $user_name

-- 4. variables, search and dynamic lookups
set $haystack "the quick brown fox"
find $haystack "fox" $found
print "fox found? " $found
get "base_val" as $copy
print "copied $base_val via get: " $copy

-- 5. modularity (loading a library from ~/.xeon/lib)
use simple
print ""

-- 6. extension system
-- running binaries from ~/.xeon/bin, capturing output in $res
print "running extension 'printc'..."
extc printc "{green}extension works{clear}"
print "captured output: " $res
print ""

-- 7. functions
-- functions and $$ pointer syntax
func greet_user $name
    print "greet_user function says: Hello, " $name "!"
end
run greet_user "World"

func create_foo_var $var
    set $$var "foo_value"
end
print "running create_foo_var to create variable my_foo using $$var..."
run create_foo_var "my_foo"
print "created variable my_foo with value: " $my_foo

-- 8. loops
repeat 3 as $i
    print "loop iteration " $i
end

print "--- script finished successfully ---"
print "tip: run xeo example.xeo -v for verbose, or xeo -p to use the pipe API!"